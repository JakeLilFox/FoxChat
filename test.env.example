# Copy this file to test.env. test.env is ignored by Git.

MATRIX_E2E_ENABLED=false
MATRIX_E2E_ALLOW_ROOM_MUTATION=false
MATRIX_E2E_ALLOW_DEVICE_RESET=false
MATRIX_E2E_ALLOW_VOICE=false

# Accounts 1 and 2 are signed into the same client and both send messages.
MATRIX_E2E_ACCOUNT_1_HOMESERVER=https://matrix.org
MATRIX_E2E_ACCOUNT_1_USER=@foxchat-e2e-one:matrix.org
MATRIX_E2E_ACCOUNT_1_PASSWORD=
MATRIX_E2E_ACCOUNT_1_RECOVERY_KEY=

# Account 2 is also used for fresh-device encrypted-history recovery.
MATRIX_E2E_ACCOUNT_2_HOMESERVER=https://matrix.org
MATRIX_E2E_ACCOUNT_2_USER=@foxchat-e2e-two:matrix.org
MATRIX_E2E_ACCOUNT_2_PASSWORD=
MATRIX_E2E_ACCOUNT_2_RECOVERY_KEY=

# Account 3 runs in a separate browser and sends remotely.
MATRIX_E2E_ACCOUNT_3_HOMESERVER=https://matrix.org
MATRIX_E2E_ACCOUNT_3_USER=@foxchat-e2e-three:matrix.org
MATRIX_E2E_ACCOUNT_3_PASSWORD=
MATRIX_E2E_ACCOUNT_3_RECOVERY_KEY=

# Account 4 is a second independent browser sender for Android multi-account
# push testing.
MATRIX_E2E_ACCOUNT_4_HOMESERVER=https://matrix.org
MATRIX_E2E_ACCOUNT_4_USER=@foxchat-e2e-four:matrix.org
MATRIX_E2E_ACCOUNT_4_PASSWORD=
MATRIX_E2E_ACCOUNT_4_RECOVERY_KEY=

# Optional test controls.
E2E_BASE_URL=http://127.0.0.1:4173
E2E_ROOM_PREFIX=FoxChat E2E
E2E_TIMEOUT_MS=90000
ANDROID_E2E_RECORD_VIDEO=true
E2E_HEADLESS=true
